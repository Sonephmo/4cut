# 해솔네컷 키오스크 환경 설정
# 이 파일을 .env 로 복사한 뒤 값을 수정하세요.
# 패키지 설치 후: 실행 파일(.exe)과 같은 폴더에 .env 를 배치하세요.

# 운영자 패널 PIN (Ctrl+Alt+O)
OPERATOR_PIN=0000

# 기본 프린터 장치 이름 (운영자 패널에서도 변경 가능)
PRINTER_DEVICE_NAME=Canon SELPHY CP1500

# 실제 인쇄 건너뛰기 (테스트용: true / 실제 운영: false)
SKIP_PRINT=false

# 환경 구분 (development / production)
APP_ENV=production

# --- Supabase (Vercel 웹앱: 업로드 + 인쇄 작업 큐) ---
# 프로젝트 URL / anon public key (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 동물의 숲 모드 · fal.ai API 키 (미설정 시 원본 이미지 그대로 반환 mock)
# fal.ai 대시보드 > Keys 에서 발급
VITE_FAL_KEY=605e0c6d-7f90-461b-9e46-2130fb07242f:27c304fe3295fcb8f4cdc4d7ade5780e
